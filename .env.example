# Copy this file to .env and fill it in. Never put .env in git: it holds passwords.
# Lines that start with # are comments and do nothing.

# Required: without these the app refuses to start and the log says what is missing.

# Public address of the store, with https and no trailing slash. Used in e-mail and WhatsApp links.
BASE_URL=https://shop.yourdomain.com

# Just the domain, without https. Caddy uses it to get the HTTPS certificate on its own.
DOMAIN=shop.yourdomain.com

# Optional: e-mail for the HTTPS certificate account. With it, Caddy falls back to ZeroSSL when Let's Encrypt fails.
ACME_EMAIL=

# Password for the admin dashboard (/admin). At least 16 characters. Changing it signs out everyone who was signed in.
# To generate one: openssl rand -base64 24
ADMIN_PASSWORD=

# Secret key that signs the cookies, the access links and the WhatsApp bot address.
# At least 32 characters. Generate with: openssl rand -hex 32
# If you change it, everyone has to sign in again, WhatsApp has to be reconnected and every password and key saved in
# Conexões has to be typed again (they are encrypted with a key derived from this one).
SECRET=

# Password for the PostgreSQL database that holds orders, buyers and products. It never leaves the server.
# Set it once before the first start: changing it later locks the app out of its own database.
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Network and files (the docker compose defaults already work)

# 1 when the app runs behind Caddy (the compose default). Without it the app cannot see the buyer's real IP:
# the attempt limit becomes one shared bucket for everyone and Meta does not receive the IP.
TRUST_PROXY=1

# Folder for uploaded videos and images. compose.yaml connects the app to PostgreSQL through DATABASE_URL;
# without DATABASE_URL (local development) the app keeps its own database in this folder instead.
DATA_DIR=/data

# Time zone for the WhatsApp quiet hours (9 pm to 9 am). Reports always use Sao Paulo days.
TZ=America/Sao_Paulo

# E-mail, Pix providers, payment webhooks and Meta are not set in this file: configure them in the admin
# dashboard, under Conexões. They take effect right away, without a restart.

# WhatsApp through the bundled Evolution API (optional)

# Internal address of the Evolution that runs next to the app and starts with it. Do not expose its port
# to the internet. To use an Evolution hosted elsewhere, set its address here and its key below.
# Connecting by QR Code in the admin dashboard registers https://YOUR_DOMAIN/api/webhooks/whatsapp on Evolution by itself.
EVOLUTION_URL=http://evolution:8080
# Optional: the AUTHENTICATION_API_KEY of the bundled Evolution. Empty uses POSTGRES_PASSWORD, which is fine because
# Evolution is reachable only inside the server. It keeps its data in its own database on the same PostgreSQL server.
EVOLUTION_KEY=

# Updates from the dashboard (see docs/deploy.md, Updating)
# The installed version. The dashboard sets it when it updates; latest follows the newest release.
LIBREFUNNEL_VERSION=latest
# Key the store uses to talk to the updater. Empty uses POSTGRES_PASSWORD; the updater has no public port.
UPDATER_TOKEN=
# Hour of the day (0 to 23) for automatic updates. Empty turns them off. Set from the dashboard.
AUTO_UPDATE_HOUR=

# Public demo (leave empty)
# 1 turns the store into a public demo: nothing is sent or charged, the sign-in shows ADMIN_PASSWORD and the data
# goes back to the demo store every day at 04:00. Never set it on a store that sells (see docs/deploy.md, Demo).
DEMO_MODE=

# Behind Cloudflare (orange cloud): its IP ranges, space-separated, so the store sees each visitor's real IP
# instead of Cloudflare's. Get them from https://www.cloudflare.com/ips-v4. Leave empty when not behind a proxy.
TRUSTED_PROXIES=
