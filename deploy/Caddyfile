(app) {
	reverse_proxy app:3000 {
		# Hold requests while the app restarts during an update instead of answering 502.
		lb_try_duration 15s
		lb_try_interval 500ms
	}
}

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# Lesson and VSL uploads go up to 1 GB; nothing else needs more than a form post.
	handle /admin/media {
		request_body {
			max_size 1100MB
		}
		import app
	}

	handle {
		request_body {
			max_size 2MB
		}
		import app
	}
}
