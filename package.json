{
  "name": "librefunnel",
  "version": "0.6.7",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "bun --bun next dev",
    "start": "docker compose up -d --build",
    "check": "bun --bun tsc --noEmit && bun --bun eslint . && bun --bun knip && bun --bun prettier --check --ignore-unknown . && bun run test",
    "fix": "bun --bun eslint --fix . && bun --bun prettier --write --ignore-unknown .",
    "test": "bun test --parallel",
    "migration": "bun --conditions=react-server node_modules/drizzle-kit/bin.cjs generate --dialect postgresql --schema src/lib/schema.ts --out src/lib/migrations",
    "release": "bun deploy/release.ts",
    "brand": "bun docs/brand.ts",
    "icons": "bun docs/icons.ts",
    "demo-art": "bun demo/art.ts"
  },
  "overrides": {
    "esbuild": "0.28.2",
    "minimatch": "11.0.8"
  },
  "knip": {
    "entry": [
      "deploy/updater.ts"
    ],
    "ignore": [
      "site/**"
    ],
    "ignoreBinaries": [
      "rsvg-convert",
      "ffmpeg"
    ]
  },
  "prettier": {
    "printWidth": 120,
    "tabWidth": 2,
    "useTabs": false,
    "semi": true,
    "singleQuote": false,
    "jsxSingleQuote": false,
    "quoteProps": "as-needed",
    "trailingComma": "all",
    "bracketSpacing": true,
    "bracketSameLine": false,
    "arrowParens": "always",
    "endOfLine": "lf",
    "proseWrap": "preserve",
    "overrides": [
      {
        "files": [
          "*.md",
          "*.mdx"
        ],
        "options": {
          "proseWrap": "always"
        }
      }
    ]
  },
  "dependencies": {
    "@ariakit/react": "0.4.43",
    "@electric-sql/pglite": "0.5.16",
    "drizzle-orm": "0.45.4",
    "hls.js": "1.7.4",
    "next": "16.4.6",
    "node-forge": "1.4.2",
    "nodemailer": "10.5.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@iconify-json/lucide": "1.2.155",
    "@iconify-json/simple-icons": "1.2.102",
    "@iconify/types": "2.0.0",
    "@stylistic/eslint-plugin": "6.0.0",
    "@types/bun": "1.4.4",
    "@types/node-forge": "1.3.14",
    "@types/nodemailer": "8.0.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "drizzle-kit": "0.31.11",
    "eslint": "10.15.0",
    "knip": "6.45.1",
    "prettier": "3.10.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.2"
  }
}
